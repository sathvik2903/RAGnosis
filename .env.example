NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=
COHERE_API_KEY=

# Multimodal provider (OpenAI-compatible vision endpoint)
OPENAI_API_KEY=
MULTIMODAL_BASE_URL=https://api.openai.com/v1
MULTIMODAL_VISION_MODEL=gpt-4.1-mini
MULTIMODAL_TIMEOUT=90
MULTIMODAL_MAX_UPLOAD_BYTES=12582912
MULTIMODAL_MAX_IMAGE_PIXELS=40000000
MULTIMODAL_MAX_VISION_DIMENSION=2048

# Grounded generation (Cohere)
COHERE_MULTIMODAL_RAG_MODEL=command-a-03-2025
COHERE_MULTIMODAL_FALLBACK_MODEL=command-r7b-12-2024

# Biomedical retrieval (NCBI PubMed E-utilities)
PUBMED_TIMEOUT=15
PUBMED_TOOL=RAGnosis
# Optional NCBI etiquette / higher rate limit:
PUBMED_EMAIL=
PUBMED_API_KEY=

# Live disease & health intelligence (public-health surveillance feeds)
HEALTH_TIMEOUT=15
HEALTH_CACHE_TTL=900
HEALTH_MAX_ITEMS_PER_SOURCE=40
HEALTH_CURRENT_DAYS=14
HEALTH_RECENT_DAYS=60
HEALTH_USER_AGENT=RAGnosis-HealthIntelligence/1.0 (research; contact via repo)
# Out-of-the-box default sources (verified reachable 2026-09-20):
#   * WHO Disease Outbreak News (JSON API)  -- global, primary official
#     https://www.who.int/api/news/diseaseoutbreaknews
#   * CDC Online Newsroom (RSS)             -- US/global, primary official
#     https://tools.cdc.gov/api/v2/resources/media/132608.rss
#   * ECDC Communicable Disease Threats Report (RSS) -- EU/global, regional
#     https://www.ecdc.europa.eu/en/taxonomy/term/2942/feed
#   * PAHO/WHO Americas (RSS)               -- Americas, regional official
#     https://www.paho.org/en/rss.xml
# These give GLOBAL + WHO coverage; India/Telangana findings appear only when a
# WHO DON item explicitly names India. There is NO out-of-the-box India- or
# Telangana-specific machine-readable official feed (see docs/AGENT_ARCHITECTURE.md).
# Do not assume "India coverage" without configuring an India source below.
#
# Override / EXTEND the built-in feeds via HEALTH_SOURCE_FEEDS. One
# "org|tier|scope|url" per line or separated by ';'.
#   tier:  primary_official | regional_official | secondary
#   scope: global | national | regional | local | unknown
# NOTE: setting HEALTH_SOURCE_FEEDS REPLACES the RSS defaults above (the WHO DON
# JSON provider is only included automatically; add it explicitly if you want it
# alongside custom feeds). Only add endpoints you have verified are reachable and
# return current official content. Do NOT scrape search-engine result pages.
#
# India example (PIB press-release RSS is LIVE but is all-ministry, not health-
# only, and served in Hindi despite Lang=1 — treat as secondary and expect noise):
# HEALTH_SOURCE_FEEDS=India PIB|secondary|national|https://pib.gov.in/RssMain.aspx?ModId=6&Lang=1&Regid=3
HEALTH_SOURCE_FEEDS=
